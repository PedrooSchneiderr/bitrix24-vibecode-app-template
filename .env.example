# Copie para .env (nunca versionado). Valores abaixo são placeholders.

# --- Runtime do app (passados via `env` no deploy, não pelo navegador) ---
PORT=3000
VIBE_API_BASE=https://vibecode.bitrix24.com/v1
# Chave vibe_api_ (prefira modo READONLY). Usada quando não há sessão do Gateway.
VIBE_API_KEY=<SUA_CHAVE_VIBE_API>
# Chave vibe_app_ do app publicado. Com ela, o backend age como o usuário logado.
VIBE_APP_KEY=<SUA_CHAVE_VIBE_APP>

# --- Somente para scripts/deploy.js ---
APP_NAME=funil-template
# Chaves que o app vai receber no servidor (se diferentes da chave de deploy).
APP_RUNTIME_API_KEY=<CHAVE_READONLY_PARA_O_APP>
APP_RUNTIME_APP_KEY=
